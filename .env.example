# PeopleForce HR platform API key
# Obtain from: Settings → Integrations → API Keys in your PeopleForce admin panel
PEOPLEFORCE_API_KEY=your_peopleforce_api_key_here

# Secret token used to authenticate inbound requests to this MCP server
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
MCP_SECRET_TOKEN=your_mcp_secret_token_here
